# Genusswerte Bonn — .htaccess

# HTTP -> HTTPS erzwingen. Ohne diese Regel liefert der Server HTTP
# und HTTPS gleichermassen aus (28.08.2026 beim Live-Check festgestellt) —
# der HSTS-Header oben greift erst NACH dem ersten HTTPS-Besuch, das
# hier faengt auch den allerersten Aufruf per http:// ab.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Disable directory browsing
Options -Indexes

# Custom 404
ErrorDocument 404 /index.html

# Charset
AddDefaultCharset UTF-8

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 1 month"
  ExpiresByType image/webp            "access plus 1 month"
  ExpiresByType text/css              "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html             "access plus 1 hour"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Nur Funktionen erlauben, die diese Seite tatsaechlich nutzt.
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()"

  # HSTS: Browser merken sich, die Seite nur noch per HTTPS aufzurufen.
  # Bewusst OHNE "includeSubDomains" — all-inkl-Hosting hat oft weitere
  # Subdomains (Mail-Webclient etc.), die nicht zwingend HTTPS-bereit
  # sind; die waeren mit includeSubDomains sonst mitbetroffen. Bewusst
  # auch OHNE "preload" — das laesst sich praktisch nicht mehr rueck-
  # gaengig machen, sobald Browser es uebernommen haben.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Content-Security-Policy: schraenkt ein, von wo Skripte/Styles/Bilder/
  # Verbindungen erlaubt sind. Lokal gegen alle 9 Seiten getestet (kein
  # einziger Verstoss) — deckt sich mit dem tatsaechlichen Code-Stand:
  # keine Inline-Skripte, keine externen Ressourcen ausser der eigenen
  # Supabase-API. Bei Erweiterung um neue externe Dienste (Analytics,
  # Zahlungs-Widgets etc.) muss die passende Domain hier ergaenzt werden,
  # sonst blockiert der Browser sie.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://dwreeykpjptfncjijjmg.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # config.js ist der Schalter fuer das Buchungssystem und darf
  # NIE aus dem Cache bedient werden. Ohne diese Regel wuerden
  # wiederkehrende Besucher nach einem Umschalten bis zu einer
  # Woche (siehe mod_expires oben) den alten Zustand sehen.
  <FilesMatch "config\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
